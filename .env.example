# Copy this file to .env.local and fill in what you have.
# Every value is optional: the app runs with none of them (rule-based parser + test payments).

# --- Claude (AI invoice parsing + reminder emails) ---
# Get a key at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Optional override. Default: claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# --- PayPal (real checkout, sandbox first) ---
# https://developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox

# --- Test payments ---
# Shows a "Simulate payment" button on the client pay page so Wren (or a demo)
# can finish the payment flow without a PayPal login.
# Default: on when PayPal is not configured, off when it is. Set true/false to force.
# ENABLE_TEST_PAYMENTS=true

# --- Database ---
# Local default: file:./data/app.db (created automatically).
# For Vercel/serverless use Turso (free): https://turso.tech
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=

# --- Optional password for the owner dashboard (client pay links stay public) ---
# APP_PASSWORD=

# Public URL used in share links/emails. Auto-detected if empty.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
